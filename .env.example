# Wavelength runs entirely on your machine. This file holds NO secrets.
#
# API keys (Groq / Gemini / Claude / OpenAI, Ticketmaster) are pasted into the
# web UI and kept only in the backend's memory for the current session.
# They are never written to disk, the database, logs or browser storage.
# The Spotify login happens in your browser (PKCE); the server never sees it.

# Local Postgres started by docker compose
DATABASE_URL=postgresql://wavelength:wavelength@localhost:5432/wavelength

# Only the local frontend may call the local API
CORS_ORIGINS=http://localhost:5173

# Dataset size: how many songs to index (more = better results, slower build)
WAVELENGTH_SONGS_EN=50000
WAVELENGTH_SONGS_EL=10000

# Optional: send traces to the local Phoenix UI (docker compose starts it on :6006)
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
