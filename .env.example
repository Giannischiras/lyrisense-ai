# Copy to .env and fill in. .env is git-ignored and must never be committed.
# These are the SERVER's own keys. Users never provide keys, and no key or
# user token is ever stored in the database.

# --- LLM provider ---
LLM_PROVIDER=anthropic            # anthropic | openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Embeddings / reranking ---
VOYAGE_API_KEY=

# --- Database (local docker-compose defaults) ---
DATABASE_URL=postgresql+psycopg://wavelength:wavelength@localhost:5432/wavelength

# --- Spotify: app credentials only (Client Credentials flow for track lookup).
# User login uses PKCE in the browser; user tokens never reach the server.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Concerts ---
TICKETMASTER_API_KEY=
LASTFM_API_KEY=

# --- Observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- API hardening ---
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT=20/minute
